# Copy to .env and adjust. Defaults assume >= 16 GiB of Docker memory.
ES_VERSION=9.3.2
LS_VERSION=9.3.2
KAFKA_VERSION=4.1.2

# Heap sizing. Lower these for the low-memory profile (see README).
ES_HEAP=4g
LS_HEAP=2g
KAFKA_HEAP=2g

# Topic geometry. 6 partitions lets scenario 04 scale consumers 1 -> 2 -> 4.
KAFKA_TOPIC=logs
KAFKA_PARTITIONS=6
KAFKA_REPLICATION=1

# Logstash pipeline tuning, identical for every arm. Batch size is the dominant
# latency knob: 125 keeps p50 near 100 ms, 1000 pushes it past 700 ms at the
# same throughput. See the tuning note in the README.
BENCH_LS_WORKERS=8
BENCH_LS_BATCH=125
